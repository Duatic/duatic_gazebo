<?xml version="1.0"?>
<!-- Test robot for the simulated DuaDrive: a gravity-loaded arm, a light wrist-like joint and a wheel. -->
<robot name="sim_duadrive_test">
  <link name="world"/>

  <link name="base_link">
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Horizontal axis; the link's centre of mass lies 0.3 m out along x, so gravity loads it at position 0. -->
  <!-- ixx and izz keep the inertia valid for Gazebo once armature is added to iyy. -->
  <link name="heavy_link">
    <inertial>
      <origin xyz="0.3 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.04" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.04"/>
    </inertial>
  </link>

  <joint name="heavy" type="revolute">
    <parent link="base_link"/>
    <child link="heavy_link"/>
    <origin xyz="0 0 1.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.0" upper="3.0" effort="120.0" velocity="10.0"/>
  </joint>

  <!-- Vertical axis through the centre of mass, so gravity puts no torque on it. -->
  <!-- ixx and iyy keep the inertia valid for Gazebo once armature is added to izz. -->
  <link name="light_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.011" ixy="0" ixz="0" iyy="0.011" iyz="0" izz="2.7e-5"/>
    </inertial>
  </link>

  <joint name="light" type="revolute">
    <parent link="base_link"/>
    <child link="light_link"/>
    <origin xyz="-0.5 0 0.5" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.0" upper="3.0" effort="40.0" velocity="10.0"/>
  </joint>

  <link name="wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>

  <joint name="wheel" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_link"/>
    <origin xyz="0.5 0.5 0.5" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" velocity="10.0"/>
  </joint>

  <ros2_control name="TestSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="heavy">
      <state_interface name="position">
        <param name="initial_value">0.05</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <command_interface name="p_gain"/>
      <command_interface name="i_gain"/>
      <command_interface name="d_gain"/>
    </joint>
    <joint name="light">
      <state_interface name="position">
        <param name="initial_value">0.05</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <command_interface name="p_gain"/>
      <command_interface name="i_gain"/>
      <command_interface name="d_gain"/>
    </joint>
    <joint name="wheel">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <command_interface name="p_gain"/>
      <command_interface name="i_gain"/>
      <command_interface name="d_gain"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>controllers.yaml</parameters>
    </plugin>
  </gazebo>
</robot>
